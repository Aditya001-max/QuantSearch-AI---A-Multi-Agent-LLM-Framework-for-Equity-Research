# ==============================================================================
# AlphaAgent Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# OpenAI API Configuration (Required)
# ------------------------------------------------------------------------------
# API key used for CrewAI agents (gpt-4o-mini) and semantic embeddings (text-embedding-ada-002)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Optional Service Configuration
# ------------------------------------------------------------------------------
# Server Host and Port for FastAPI backend
HOST=127.0.0.1
PORT=8000

# Optional Tavily API Key for external search enhancements (if enabled)
# TAVILY_API_KEY=your_tavily_api_key_here
